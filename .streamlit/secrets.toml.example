# Copia este ficheiro para .streamlit/secrets.toml (local) ou cola o conteúdo em
# Streamlit Cloud > App > Settings > Secrets. NUNCA envies o secrets.toml para o GitHub.

# ── Supabase (Project Settings > API) ──────────────────
supabase_url = "https://SEU-PROJECTO.supabase.co"
supabase_key = "CHAVE_service_role"      # a chave service_role, NÃO a anon. Fica só no servidor.

# ── Segurança ──────────────────────────────────────────
cookie_key   = "troca-isto-por-uma-frase-longa-e-aleatoria"
modelos_key  = "outra-frase-longa-e-aleatoria"   # assina os modelos guardados (Laboratório de ML). Sem isto usa cookie_key.
contas_demo  = false                      # desliga as contas aluno/professor/admin de demonstração

# Código para criar o PRIMEIRO administrador (só funciona enquanto não existir nenhum).
# Os professores entram com convites de uso único criados pelo admin em Administração > Convites.
admin_code     = "CODIGO-ADMIN-SECRETO"
admin_email    = "o-teu-email@exemplo.com"    # recebe os avisos de empresas a aguardar aprovação

# ── Email (Brevo: app.brevo.com > SMTP & API > SMTP) ───
smtp_host      = "smtp-relay.brevo.com"
smtp_port      = 587
smtp_user      = "LOGIN-SMTP-DO-BREVO"
smtp_password  = "CHAVE-SMTP-DO-BREVO"
email_from     = "remetente-verificado@exemplo.com"   # tem de estar verificado no Brevo
email_from_nome = "DataForge"
email_limite_diario = 300                              # plano grátis do Brevo (confirma no site)

# ── IA (opcional; sem a chave a IA fica desligada) ──
# Grátis: Google Gemini (chave em aistudio.google.com/apikey, sem cartão; tem limites diários).
# ia_provedor      = "gemini"
# ia_api_key       = "a-tua-chave"
# Pago: Grok da xAI (chave em console.x.ai; precisa de créditos): ia_provedor = "xai"
# O nome do modelo muda com frequência: se precisares, define ia_model = "..." (vê o nome actual na consola do provedor).
# ia_limite_diario = 30                      # pedidos à IA por empresa e por dia
# ia_limite_aluno  = 20                      # perguntas ao tutor de IA por aluno e por dia
# ia_limite_professor = 30                   # pedidos à IA por professor e por dia
# Para não esgotar o limite da chave (o limite do Gemini gratuito é da chave, não de cada aluno):
# ia_limite_global_dia    = 200              # tecto da chave inteira por dia (0 = sem tecto). Confirma o limite do teu plano na consola
# ia_limite_global_minuto = 8                # tecto da chave inteira por minuto (0 = sem tecto)
# ia_reserva_pct = 30                        # % do tecto diário reservada a empresas e professores (os alunos não lhe tocam)
# ia_intervalo   = 5                         # segundos mínimos entre pedidos do mesmo aluno ou professor (0 = sem intervalo)
# ia_model_tutor = "..."                     # modelo do tutor (por omissão, no Gemini, o modelo «lite»; confirma o nome na consola)
# Chave de reserva (opcional): usada só se a principal der «demasiados pedidos» ou falhar. Lê antes os termos de cada serviço:
# repartir um uso grande por várias contas gratuitas pode violá-los.
# ia_api_key_2 = "..."                       # (opcionais: ia_provedor_2, ia_model_2, ia_base_url_2)

# ── Certificados ───────────────────────────────────────
app_url = "https://a-tua-app.streamlit.app"   # usado no QR code de verificação

# ── Login com Google (opcional; ver docs.streamlit.io, st.login) ──
# [auth]
# redirect_uri = "https://a-tua-app.streamlit.app/oauth2callback"
# cookie_secret = "outra-frase-longa-e-aleatoria"
# [auth.google]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
