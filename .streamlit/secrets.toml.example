# Copia este ficheiro para .streamlit/secrets.toml (local) ou cola o conteúdo em
# Streamlit Cloud > App > Settings > Secrets. NUNCA envies o secrets.toml para o GitHub.

# ── Supabase (Project Settings > API) ──────────────────
supabase_url = "https://SEU-PROJECTO.supabase.co"
supabase_key = "CHAVE_service_role"      # a chave service_role, NÃO a anon. Fica só no servidor.

# ── Segurança ──────────────────────────────────────────
cookie_key   = "troca-isto-por-uma-frase-longa-e-aleatoria"
contas_demo  = false                      # desliga as contas aluno/professor/admin de demonstração

# Códigos para criar contas especiais no registo (inventa os teus)
professor_code = "CODIGO-PROFESSOR-SECRETO"
admin_code     = "CODIGO-ADMIN-SECRETO"

# ── Certificados ───────────────────────────────────────
app_url = "https://a-tua-app.streamlit.app"   # usado no QR code de verificação

# ── Login com Google (opcional; ver docs.streamlit.io, st.login) ──
# [auth]
# redirect_uri = "https://a-tua-app.streamlit.app/oauth2callback"
# cookie_secret = "outra-frase-longa-e-aleatoria"
# [auth.google]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
