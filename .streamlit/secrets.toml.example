# Copia este ficheiro para .streamlit/secrets.toml (local) ou cola o conteúdo em
# Streamlit Cloud > App > Settings > Secrets. NUNCA envies o secrets.toml para o GitHub.

# ── Supabase (Project Settings > API) ──────────────────
supabase_url = "https://SEU-PROJECTO.supabase.co"
supabase_key = "CHAVE_service_role"      # a chave service_role, NÃO a anon. Fica só no servidor.

# ── Segurança ──────────────────────────────────────────
cookie_key   = "troca-isto-por-uma-frase-longa-e-aleatoria"
contas_demo  = false                      # desliga as contas aluno/professor/admin de demonstração

# Código para criar o PRIMEIRO administrador (só funciona enquanto não existir nenhum).
# Os professores entram com convites de uso único criados pelo admin em Administração > Convites.
admin_code     = "CODIGO-ADMIN-SECRETO"
admin_email    = "o-teu-email@exemplo.com"    # recebe os avisos de empresas a aguardar aprovação

# ── Email (Brevo: app.brevo.com > SMTP & API > SMTP) ───
smtp_host      = "smtp-relay.brevo.com"
smtp_port      = 587
smtp_user      = "LOGIN-SMTP-DO-BREVO"
smtp_password  = "CHAVE-SMTP-DO-BREVO"
email_from     = "remetente-verificado@exemplo.com"   # tem de estar verificado no Brevo
email_from_nome = "DataForge"
email_limite_diario = 300                              # plano grátis do Brevo (confirma no site)

# ── IA com o Grok da xAI (opcional; sem a chave a IA fica desligada) ──
# Chave em console.x.ai > API Keys. O nome do modelo muda com frequência: confirma o actual na consola da xAI.
# xai_api_key      = "xai-..."
# xai_model        = "grok-4-1-fast-non-reasoning"
# ia_limite_diario = 30                      # pedidos à IA por empresa e por dia

# ── Certificados ───────────────────────────────────────
app_url = "https://a-tua-app.streamlit.app"   # usado no QR code de verificação

# ── Login com Google (opcional; ver docs.streamlit.io, st.login) ──
# [auth]
# redirect_uri = "https://a-tua-app.streamlit.app/oauth2callback"
# cookie_secret = "outra-frase-longa-e-aleatoria"
# [auth.google]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
